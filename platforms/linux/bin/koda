#!/usr/bin/env bash
set -euo pipefail

# Linux distribution runs on imported data; old config flags cannot enable OSV.
export KODA_OFFLINE_MODE="${KODA_OFFLINE_MODE:-1}"
export KODA_EXCLUDE_OSV=1
export KODA_REQUIRE_MANAGED_DATA=1
export KODA_VULN_DATA_ROOT="${KODA_VULN_DATA_ROOT:-/var/lib/koda-vuln-data}"
export GRYPE_DB_AUTO_UPDATE=false
export GRYPE_CHECK_FOR_APP_UPDATE=false
export GRYPE_EXTERNAL_SOURCES_ENABLE=false

select_python() {
  if [ -n "${KODA_PYTHON:-}" ]; then
    printf '%s\n' "$KODA_PYTHON"
    return
  fi
  for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  printf '%s\n' python3
}

python_bin="$(select_python)"
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)"
  link_target="$(readlink "$source_path")"
  case "$link_target" in
    /*) source_path="$link_target" ;;
    *) source_path="$source_dir/$link_target" ;;
  esac
done
script_dir="$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)"
bundle_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"

if [ -f "$bundle_root/python-interpreter" ]; then
  configured_python=''
  IFS= read -r configured_python < "$bundle_root/python-interpreter" || true
  if [ -n "$configured_python" ] \
    && { command -v "$configured_python" >/dev/null 2>&1 || [ -x "$configured_python" ]; }; then
    python_bin="$configured_python"
  fi
fi

# Prefer the bundled renderer libraries so the optional SPA rendering can
# import Playwright without pip, venv, or network access. The scanner core is
# stdlib-only, so the same interpreter is used for every command.
if [ -d "$bundle_root/render-lib" ]; then
  export PYTHONPATH="$bundle_root/render-lib${PYTHONPATH:+:$PYTHONPATH}"
fi

if [ -x "$bundle_root/tools/syft" ]; then
  export KODA_SYFT_BIN="${KODA_SYFT_BIN:-$bundle_root/tools/syft}"
fi
if [ -x "$bundle_root/tools/grype" ]; then
  export KODA_GRYPE_BIN="${KODA_GRYPE_BIN:-$bundle_root/tools/grype}"
fi
# Approved current release is the only CVE source; packaged legacy feeds are not selected.
if [ -d "$bundle_root/app/security_scanner" ]; then
  app_root="$bundle_root/app"
elif [ -d "$bundle_root/../security_scanner" ]; then
  app_root="$(CDPATH= cd -- "$bundle_root/.." && pwd)"
elif [ -d "$bundle_root/security_scanner" ]; then
  app_root="$bundle_root"
else
  exec "$python_bin" -m security_scanner "$@"
fi

export PYTHONPATH="$app_root${PYTHONPATH:+:$PYTHONPATH}"
exec "$python_bin" -m security_scanner "$@"
