#!/usr/bin/env bash
# One entry point for the combined KODA + KODA SBOM Tracker air-gap release.
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
default_prefix="${KODA_SUITE_PREFIX:-${HOME:-$PWD}/koda-suite}"
install_tmp=""
prepared_koda_root=""
prepared_tracker_vuln_bundle=""

cleanup_install_tmp() {
  [[ -z "$install_tmp" || ! -d "$install_tmp" ]] || rm -rf "$install_tmp"
}
trap cleanup_install_tmp EXIT

usage() {
  cat <<'EOF'
Usage:
  koda-suite verify
  koda-suite preflight --env-file FILE [--prefix DIR] [--require-vulnerability-data]
  koda-suite install --env-file FILE [--prefix DIR]
  koda-suite patch --group GROUP [--prefix DIR]
  koda-suite start [--prefix DIR]
  koda-suite status [--prefix DIR]
  koda-suite stop [--prefix DIR]

The install command verifies, installs, and starts both products. A production
Tracker env file with real secrets and a least-privilege Dependency-Track API
key is required and is never stored in the release archive.

Patch groups: koda, gateway, portal-web, portal-api-worker, dependency-track.
Patches preserve volumes and require the new release's Compose contracts to
match the installed release. Incompatible data/schema changes require a full
install; reset-install.sh is reserved for intentional data destruction.
EOF
}

fail() { echo "error: $*" >&2; exit 2; }

verify_release() {
  local metadata_file="$script_dir/metadata.env"
  [[ -f "$script_dir/manifest.sha256" ]] || fail "manifest.sha256 is missing."
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "$script_dir" && sha256sum --check --quiet manifest.sha256)
  elif command -v shasum >/dev/null 2>&1; then
    (cd "$script_dir" && shasum -a 256 -c manifest.sha256 >/dev/null)
  else
    fail "sha256sum is required on the Linux server."
  fi
  [[ -f "$metadata_file" ]] || fail "metadata.env is missing."
  [[ -f "$script_dir/compose.integration.yaml" && -f "$script_dir/gateway/gateway.conf.template" ]] \
    || fail "gateway integration files are missing."
  [[ -x "$script_dir/reset-install.sh" && -f "$script_dir/.env.example" \
      && -f "$script_dir/koda-suite.env.example" ]] \
    || fail "reset installer or split env examples are missing."
  for required in \
    'AUTHORITY=tracker' 'AUTH_CONTRACT_VERSION=1' \
    'AUTH_COOKIE_NAME=__Host-koda_session' 'AUTH_COOKIE_SCHEMA_VERSION=2' \
    'TRACKER_SESSION_ENDPOINT=/api/v1/auth/session' 'KODA_BASE_PATH=/koda/' \
    'GATEWAY_AUTH_MODE=auth_request' 'KODA_PORTAL_SCHEMA_VERSION=1' \
    'KODA_RBAC_CATALOG_VERSION=koda-rbac-v1'; do
    grep -qx "$required" "$metadata_file" || fail "metadata contract entry is missing: $required"
  done
  grep -qx 'TARGET_PLATFORM=linux/amd64' "$metadata_file" \
    || fail "release is not linux/amd64."
  grep -qx 'DISTRIBUTION_SCOPE=internal-only' "$metadata_file" \
    || fail "release is not marked internal-only."
  # Older suite archives did not carry these provenance fields; validate them
  # when present while keeping those archives inspectable for rollback.
  for dirty_key in KODA_WORKTREE_DIRTY TRACKER_GIT_WORKTREE_DIRTY; do
    if grep -q "^${dirty_key}=" "$metadata_file"; then
      dirty_value="$(metadata_value "$metadata_file" "$dirty_key")"
      [[ "$dirty_value" == false ]] \
        || fail "production release must be clean: $dirty_key=$dirty_value"
    fi
  done
  if grep -q '^KODA_WORKTREE_DIRTY=' "$metadata_file" || grep -q '^TRACKER_GIT_WORKTREE_DIRTY=' "$metadata_file"; then
    for revision_key in KODA_GIT_REVISION TRACKER_GIT_REVISION; do
      revision="$(metadata_value "$metadata_file" "$revision_key")"
      [[ "$revision" =~ ^[0-9a-fA-F]{40}$ ]] \
        || fail "invalid production revision in metadata.env: $revision_key=$revision"
    done
  fi
  KODA_BUNDLE="$(metadata_value "$metadata_file" KODA_BUNDLE)"
  TRACKER_BUNDLE="$(metadata_value "$metadata_file" TRACKER_BUNDLE)"
  TRACKER_VULNERABILITY_BUNDLE="$(metadata_value "$metadata_file" TRACKER_VULNERABILITY_BUNDLE)"
  case "$TRACKER_VULNERABILITY_BUNDLE" in
    included|absent) ;;
    *) fail "invalid Tracker vulnerability bundle state: $TRACKER_VULNERABILITY_BUNDLE" ;;
  esac
  for payload in "$KODA_BUNDLE" "$TRACKER_BUNDLE"; do
    case "$payload" in
      bundles/*.tar.gz) ;;
      *) fail "invalid payload path in metadata.env: $payload" ;;
    esac
    [[ "$payload" != *'/../'* && "$payload" != *'//'* ]] \
      || fail "unsafe payload path in metadata.env: $payload"
  done
  [[ -f "$script_dir/$KODA_BUNDLE" ]] || fail "KODA payload is missing."
  [[ -f "$script_dir/$TRACKER_BUNDLE" ]] || fail "Tracker payload is missing."
  verify_inner_manifests "$script_dir/$KODA_BUNDLE" "$script_dir/$TRACKER_BUNDLE"
  echo "KODA Suite release integrity OK"
}

metadata_value() {
  local file="$1" key="$2" count
  count="$(grep -c "^${key}=" "$file" || true)"
  [[ "$count" == 1 ]] || fail "metadata.env must contain exactly one $key entry."
  sed -n "s/^${key}=//p" "$file"
}

verify_inner_manifests() {
  python3 - "$@" <<'PY'
import hashlib
import pathlib
import posixpath
import sys
import tarfile

def verify(path):
    with tarfile.open(path, "r:gz") as archive:
        members = {posixpath.normpath(m.name): m for m in archive.getmembers()}
        if "manifest.sha256" in members:
            root = ""
            manifest_name = "manifest.sha256"
        else:
            roots = {name.split("/", 1)[0] for name in members if name not in {"", "."}}
            root = next(iter(roots)) if len(roots) == 1 else ""
            manifest_name = f"{root}/manifest.sha256" if root else "manifest.sha256"
        if manifest_name not in members:
            raise SystemExit(f"inner manifest is missing: {path}")
        manifest = archive.extractfile(members[manifest_name])
        assert manifest is not None
        for line in manifest.read().decode("utf-8").splitlines():
            if not line.strip():
                continue
            digest, relative = line.split(None, 1)
            relative = relative.lstrip(" *")
            member_name = f"{root}/{posixpath.normpath(relative)}" if root else posixpath.normpath(relative)
            member = members.get(member_name)
            if member is None or not member.isfile():
                raise SystemExit(f"inner manifest entry is missing: {path}: {relative}")
            stream = archive.extractfile(member)
            assert stream is not None
            checksum = hashlib.sha256()
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                checksum.update(chunk)
            actual = checksum.hexdigest()
            if actual != digest:
                raise SystemExit(f"inner manifest mismatch: {path}: {relative}")

for value in sys.argv[1:]:
    verify(pathlib.Path(value))
PY
}

require_runtime() {
  case "$(uname -m)" in
    x86_64|amd64) ;;
    *) fail "this release requires Linux x86_64; host is $(uname -m)." ;;
  esac
  for command_name in docker python3 tar sha256sum flock realpath; do
    command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required."
  done
  docker info >/dev/null 2>&1 || fail "cannot reach the Docker daemon."
  docker compose version >/dev/null 2>&1 || fail "the Docker Compose plugin is required."
}

safe_extract() {
  local archive="$1" destination="$2"
  python3 - "$archive" <<'PY'
import posixpath
import sys
import tarfile

with tarfile.open(sys.argv[1], "r:gz") as archive:
    for member in archive.getmembers():
        name = member.name
        normalized = posixpath.normpath(name)
        if name.startswith("/") or normalized == ".." or normalized.startswith("../"):
            raise SystemExit(f"unsafe archive path: {name}")
        if member.issym() or member.islnk():
            target = posixpath.normpath(posixpath.join(posixpath.dirname(normalized), member.linkname))
            if member.linkname.startswith("/") or target == ".." or target.startswith("../"):
                raise SystemExit(f"unsafe archive link: {name} -> {member.linkname}")
PY
  mkdir -p "$destination"
  tar -xzf "$archive" -C "$destination"
}

env_value() {
  local file="$1" key="$2" fallback="$3" value
  # Keep parsing portable across mawk/gawk; escaped quote regexes emit
  # warnings on Linux and add noise to every lifecycle command.
  value="$(awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); value=$0 } END { print value }' "$file")"
  value="${value#${value%%[![:space:]]*}}"
  value="${value%${value##*[![:space:]]}}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then value="${value:1:${#value}-2}"; fi
  if [[ "$value" == \'*\' && "$value" == *\' ]]; then value="${value:1:${#value}-2}"; fi
  printf '%s\n' "${value:-$fallback}"
}

ensure_tracker_integration_secrets() {
  local env_file="$1" prefix secret_file token_dir
  prefix="$(dirname -- "$(dirname -- "$env_file")")"
  secret_file="$(env_value "$env_file" KODA_TRACKER_PROVISIONING_TOKEN_FILE "$prefix/config/koda-tracker-provisioning.token")"
  token_dir="$(env_value "$env_file" KODA_TRACKER_TOKEN_DIR "$prefix/config/tracker-tokens")"
  python3 - "$env_file" "$secret_file" "$token_dir" "$prefix/config" <<'PY'
import os
import secrets
import stat
import sys
from pathlib import Path

env_file, secret_file, token_dir, private_root = map(Path, sys.argv[1:])
private_root.mkdir(parents=True, exist_ok=True, mode=0o700)
os.chmod(private_root, 0o700)

for parent in {secret_file.parent, token_dir.parent}:
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        parent.relative_to(private_root)
    except ValueError:
        if stat.S_IMODE(parent.stat().st_mode) & 0o077:
            raise SystemExit(f"custom integration secret parent must be private (0700): {parent}")
    else:
        os.chmod(parent, 0o700)

token_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
# The private parent prevents host traversal. These bind-mount modes let the
# fixed non-root container UIDs read the shared token and let KODA create its
# own mode-0600 repository tokens without running either container as root.
os.chmod(token_dir, 0o733)
if not secret_file.exists():
    temporary = secret_file.with_name(f".{secret_file.name}.{os.getpid()}.tmp")
    with temporary.open("x", encoding="utf-8") as output:
        os.chmod(temporary, 0o600)
        output.write(secrets.token_urlsafe(48) + "\n")
        output.flush()
        os.fsync(output.fileno())
    temporary.replace(secret_file)
os.chmod(secret_file, 0o444)

values = {
    "KODA_TRACKER_PROVISIONING_TOKEN_FILE": str(secret_file),
    "KODA_TRACKER_TOKEN_DIR": str(token_dir),
}
lines = env_file.read_text(encoding="utf-8").splitlines()
seen = set()
for index, line in enumerate(lines):
    key = line.split("=", 1)[0]
    if key in values:
        lines[index] = f"{key}={values[key]}"
        seen.add(key)
for key, value in values.items():
    if key not in seen:
        lines.append(f"{key}={value}")
temporary = env_file.with_name(f".{env_file.name}.{os.getpid()}.tmp")
temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
os.chmod(temporary, env_file.stat().st_mode & 0o777)
temporary.replace(env_file)
PY
}

wait_http() {
  local url="$1" expected="${2:-}" timeout="${3:-60}"
  python3 - "$url" "$expected" "$timeout" <<'PY'
import html
import sys
import time
import urllib.error
import urllib.request

url, expected, timeout = sys.argv[1], sys.argv[2], int(sys.argv[3])
deadline = time.monotonic() + timeout
last = "no response"
while time.monotonic() < deadline:
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            body = response.read().decode("utf-8", "replace")
            if 200 <= response.status < 400 and (not expected or expected in body or html.escape(expected, quote=True) in body):
                print(f"OK {url}")
                raise SystemExit(0)
            last = f"HTTP {response.status}, expected content missing"
    except (OSError, urllib.error.URLError) as error:
        last = str(error)
    time.sleep(2)
raise SystemExit(f"health check failed: {url}: {last}")
PY
}

runtime_values() {
  local env_file="$1" dashboard_network base_path app_subnet gateway_ip
  public_port="${PUBLIC_HTTP_PORT:-$(env_value "$env_file" PUBLIC_HTTP_PORT 8088)}"
  koda_port="${KODA_PORT:-$(env_value "$env_file" KODA_PORT 8765)}"
  koda_bind="${KODA_DASHBOARD_BIND:-$(env_value "$env_file" KODA_DASHBOARD_BIND 127.0.0.1)}"
  tracker_url="${KODA_SSBOM_TRACKER_URL:-$(env_value "$env_file" KODA_SSBOM_TRACKER_URL "http://127.0.0.1:$public_port/?page=runs")}"
  gitlab_url="${KODA_GITLAB_URL:-$(env_value "$env_file" KODA_GITLAB_URL "")}"
  gitlab_token_file="${KODA_GITLAB_TOKEN_FILE:-$(env_value "$env_file" KODA_GITLAB_TOKEN_FILE "")}"
  gitlab_write_token_file="${KODA_GITLAB_WRITE_TOKEN_FILE:-$(env_value "$env_file" KODA_GITLAB_WRITE_TOKEN_FILE "")}"
  gitlab_ca_file="${KODA_GITLAB_CA_FILE:-$(env_value "$env_file" KODA_GITLAB_CA_FILE "")}"
  gitlab_network="${KODA_GITLAB_NETWORK:-$(env_value "$env_file" KODA_GITLAB_NETWORK "")}"
  tracker_api_url="${KODA_TRACKER_URL:-$(env_value "$env_file" KODA_TRACKER_URL "")}"
  tracker_token_dir="${KODA_TRACKER_TOKEN_DIR:-$(env_value "$env_file" KODA_TRACKER_TOKEN_DIR "")}"
  tracker_provisioning_file="${KODA_TRACKER_PROVISIONING_TOKEN_FILE:-$(env_value "$env_file" KODA_TRACKER_PROVISIONING_TOKEN_FILE "")}"
  tracker_result_timeout="${KODA_TRACKER_RESULT_TIMEOUT_SECONDS:-$(env_value "$env_file" KODA_TRACKER_RESULT_TIMEOUT_SECONDS 900)}"
  tracker_ca_file="${KODA_TRACKER_CA_FILE:-$(env_value "$env_file" KODA_TRACKER_CA_FILE "")}"
  gateway_scheme="${GATEWAY_PUBLIC_SCHEME:-$(env_value "$env_file" GATEWAY_PUBLIC_SCHEME https)}"
  tracker_env="${TRACKER_ENVIRONMENT:-$(env_value "$env_file" TRACKER_ENVIRONMENT production)}"
  tracker_secure_cookies="${TRACKER_SECURE_COOKIES:-$(env_value "$env_file" TRACKER_SECURE_COOKIES true)}"
  dashboard_network="$(env_value "$env_file" KODA_DASHBOARD_NETWORK koda-dashboard)"
  base_path="$(env_value "$env_file" KODA_BASE_PATH /koda/)"
  app_subnet="$(env_value "$env_file" APP_NETWORK_SUBNET 172.30.80.0/24)"
  gateway_ip="$(env_value "$env_file" GATEWAY_APP_IP 172.30.80.10)"
  [[ "$koda_bind" == 127.0.0.1 || "$koda_bind" == ::1 ]] || fail "KODA direct port must remain loopback-only."
  [[ "$dashboard_network" == koda-dashboard ]] \
    || fail "KODA_DASHBOARD_NETWORK must remain koda-dashboard."
  [[ "$base_path" == /koda/ ]] || fail "KODA_BASE_PATH must remain /koda/."
  if [[ "$tracker_env" != development ]]; then
    [[ "$gateway_scheme" == https && "$tracker_secure_cookies" == true ]] \
      || fail "production requires HTTPS gateway scheme and secure Tracker cookies."
  fi
  python3 - "$app_subnet" "$gateway_ip" <<'PY'
import ipaddress
import sys

network = ipaddress.ip_network(sys.argv[1], strict=True)
address = ipaddress.ip_address(sys.argv[2])
if network.version != 4 or address.version != 4:
    raise SystemExit("APP_NETWORK_SUBNET and GATEWAY_APP_IP must be IPv4")
if address not in network or address in {network.network_address, network.broadcast_address}:
    raise SystemExit("GATEWAY_APP_IP must be a usable address inside APP_NETWORK_SUBNET")
PY
}

suite_compose() {
  local prefix="$1"
  shift
  docker compose --project-directory "$prefix/tracker" --env-file "$prefix/tracker/.env" \
    -f "$prefix/tracker/compose.yaml" -f "$prefix/tracker/compose.airgap.yaml" \
    -f "$prefix/tracker/compose.integration.yaml" "$@"
}

start_dashboard() {
  local prefix="$1" env_file="$prefix/tracker/.env"
  ensure_tracker_integration_secrets "$env_file"
  runtime_values "$env_file"
  "$prefix/koda/koda-docker" dashboard stop >/dev/null
  KODA_PORT="$koda_port" \
  KODA_DASHBOARD_BIND="$koda_bind" \
  KODA_PUBLISH_DASHBOARD=0 \
  KODA_PORTAL_DATA_DIR="$prefix/data/koda-portal" \
  KODA_SSBOM_TRACKER_URL="$tracker_url" \
  KODA_GITLAB_URL="$gitlab_url" \
  KODA_GITLAB_TOKEN_FILE="$gitlab_token_file" \
  KODA_GITLAB_WRITE_TOKEN_FILE="$gitlab_write_token_file" \
  KODA_GITLAB_CA_FILE="$gitlab_ca_file" \
  KODA_GITLAB_NETWORK="$gitlab_network" \
  KODA_TRACKER_URL="$tracker_api_url" \
  KODA_TRACKER_TOKEN_DIR="$tracker_token_dir" \
  KODA_TRACKER_PROVISIONING_TOKEN_FILE="$tracker_provisioning_file" \
  KODA_TRACKER_RESULT_TIMEOUT_SECONDS="$tracker_result_timeout" \
  KODA_TRACKER_CA_FILE="$tracker_ca_file" \
    "$prefix/koda/koda-docker" dashboard start
}

runtime_health() {
  local prefix="$1" env_file="$prefix/tracker/.env" internal masquerade port_bindings
  runtime_values "$env_file"
  wait_http "http://127.0.0.1:$public_port/healthz" "" 30
  wait_http "http://127.0.0.1:$public_port/koda/live" "" 30
  wait_http "http://127.0.0.1:$public_port/api/v1/healthz" "" 30
  wait_http "http://127.0.0.1:$public_port/dependency-track/" "Dependency-Track" 60
  wait_http "http://127.0.0.1:$public_port/dependency-track/static/config.json" "API_BASE_URL" 60
  wait_http "http://127.0.0.1:$public_port/dependency-track/api/version" "version" 60
  masquerade="$(docker network inspect -f '{{index .Options "com.docker.network.bridge.enable_ip_masquerade"}}' koda-dashboard 2>/dev/null || true)"
  [[ "$masquerade" == false ]] || fail "KODA dashboard network egress guard is not disabled."
  if [[ -n "$gitlab_network" ]]; then
    internal="$(docker network inspect -f '{{.Internal}}' koda-dashboard 2>/dev/null || true)"
    [[ "$internal" == true ]] \
      || fail "KODA dashboard network must be internal when GitLab egress is configured."
  fi
  port_bindings="$(docker inspect -f '{{json .HostConfig.PortBindings}}' koda-dashboard 2>/dev/null || true)"
  [[ "$port_bindings" == null || "$port_bindings" == '{}' ]] \
    || fail "KODA dashboard has a directly published host port: $port_bindings"
  echo "Suite:   ${gateway_scheme}://<server>:${public_port}/"
}

parse_prefix() {
  prefix="$default_prefix"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prefix) prefix="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
}

prepare_payloads() {
  verify_release
  require_runtime
  install_tmp="$(mktemp -d "${TMPDIR:-/tmp}/koda-suite.XXXXXX")"
  safe_extract "$script_dir/$KODA_BUNDLE" "$install_tmp/koda"
  safe_extract "$script_dir/$TRACKER_BUNDLE" "$install_tmp/tracker"
  prepared_koda_root="$(find "$install_tmp/koda" -mindepth 1 -maxdepth 1 -type d -print -quit)"
  [[ -n "$prepared_koda_root" && -x "$prepared_koda_root/install.sh" \
      && -f "$prepared_koda_root/manifest.sha256" ]] \
    || fail "invalid KODA payload."
  [[ -x "$install_tmp/tracker/scripts/install-airgap.sh" \
      && -x "$install_tmp/tracker/scripts/preflight-airgap.sh" ]] \
    || fail "invalid Tracker payload."
  prepared_tracker_vuln_bundle="$(metadata_value "$install_tmp/tracker/metadata.env" VULNERABILITY_BUNDLE)"
  [[ "$prepared_tracker_vuln_bundle" == "$TRACKER_VULNERABILITY_BUNDLE" ]] \
    || fail "Tracker vulnerability bundle metadata mismatch."
  (cd "$prepared_koda_root" && sha256sum --check --quiet manifest.sha256) \
    || fail "KODA inner bundle checksum verification failed."
}

validate_preflight() {
  local env_file="$1" require_vulnerability_data="${2:-0}"
  "$install_tmp/tracker/scripts/preflight-airgap.sh" "$env_file"
  runtime_values "$env_file"
  if [[ "$require_vulnerability_data" == 1 ]]; then
    [[ "$TRACKER_VULNERABILITY_BUNDLE" == included \
        && -d "$install_tmp/tracker/vulnerability-data" \
        && ! -L "$install_tmp/tracker/vulnerability-data" ]] \
      || fail "this operation requires an included Tracker vulnerability bundle."
    ENV_FILE="$env_file" \
      "$install_tmp/tracker/scripts/verify-vuln-bundle.sh" \
      "$install_tmp/tracker/vulnerability-data"
  fi
}

preflight_suite() {
  local env_file="" prefix="$default_prefix" require_vulnerability_data=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env-file) env_file="${2:-}"; shift 2 ;;
      --prefix) prefix="${2:-}"; shift 2 ;;
      --require-vulnerability-data) require_vulnerability_data=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
  [[ -n "$env_file" && -f "$env_file" ]] || fail "preflight requires --env-file FILE."
  env_file="$(CDPATH= cd -- "$(dirname -- "$env_file")" && pwd)/$(basename -- "$env_file")"
  [[ -n "$prefix" ]] || fail "install prefix may not be empty."
  prepare_payloads
  validate_preflight "$env_file" "$require_vulnerability_data"
  echo "KODA Suite preflight OK"
}

install_suite() {
  local env_file="" prefix="$default_prefix"
  local tracker_install_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env-file) env_file="${2:-}"; shift 2 ;;
      --prefix) prefix="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
  [[ -n "$env_file" && -f "$env_file" ]] || fail "install requires --env-file FILE."
  env_file="$(CDPATH= cd -- "$(dirname -- "$env_file")" && pwd)/$(basename -- "$env_file")"
  prepare_payloads

  tracker_install_args=(
    "$script_dir/$TRACKER_BUNDLE"
    "$prefix/tracker"
    --env-file "$env_file"
  )
  case "$TRACKER_VULNERABILITY_BUNDLE" in
    included)
      [[ -d "$install_tmp/tracker/vulnerability-data" \
          && ! -L "$install_tmp/tracker/vulnerability-data" ]] \
        || fail "included Tracker vulnerability data is missing or unsafe."
      [[ -f "$prefix/metadata.env" ]] \
        || tracker_install_args+=(--import-vuln-bundle)
      ;;
    absent)
      [[ ! -e "$install_tmp/tracker/vulnerability-data" \
          && ! -L "$install_tmp/tracker/vulnerability-data" ]] \
        || fail "unexpected Tracker vulnerability data in release."
      ;;
  esac

  # Validate all secrets and Compose wiring before loading either product.
  validate_preflight "$env_file" 0
  "$prepared_koda_root/install.sh" --prefix "$prefix/koda"
  "$install_tmp/tracker/scripts/install-airgap.sh" "${tracker_install_args[@]}"

  mkdir -p "$prefix/config"
  install -m 0644 "$script_dir/compose.integration.yaml" "$prefix/tracker/compose.integration.yaml"
  mkdir -p "$prefix/tracker/gateway"
  install -m 0644 "$script_dir/gateway/gateway.conf.template" "$prefix/tracker/gateway/gateway.conf.template"
  install -m 0755 "$script_dir/koda-suite" "$prefix/koda-suite"
  cp "$script_dir/README.ko.md" "$script_dir/TROUBLESHOOTING.ko.md" \
    "$script_dir/metadata.env" "$prefix/"
  cp "$script_dir/.env.example" "$script_dir/koda-suite.env.example" "$prefix/config/"
  start_dashboard "$prefix"
  # Recreate only this Compose project's containers after loading the new
  # images. Named volumes and the KODA portal host directory stay attached.
  suite_compose "$prefix" up -d --no-build --pull never --force-recreate
  runtime_health "$prefix"
  echo "installed and started: $prefix"
}

require_same_contract() {
  local prefix="$1" key installed current
  for key in \
    AUTHORITY AUTH_CONTRACT_VERSION AUTH_COOKIE_NAME AUTH_COOKIE_SCHEMA_VERSION \
    TRACKER_SESSION_ENDPOINT KODA_BASE_PATH GATEWAY_AUTH_MODE \
    KODA_PORTAL_SCHEMA_VERSION KODA_RBAC_CATALOG_VERSION; do
    installed="$(metadata_value "$prefix/metadata.env" "$key")"
    current="$(metadata_value "$script_dir/metadata.env" "$key")"
    [[ "$installed" == "$current" ]] \
      || fail "patch contract changed for $key; use a full install (reset only incompatible data)."
  done
}

require_same_file() {
  local current="$1" installed="$2"
  [[ -f "$installed" && -f "$current" && "$(sha256sum "$current" | awk '{print $1}')" \
      == "$(sha256sum "$installed" | awk '{print $1}')" ]] \
    || fail "$(basename -- "$installed") changed; use a full install (reset only incompatible data)."
}

tracker_image_ref() {
  local env_file="$1" variable="$2" base tag
  case "$variable" in
    PORTAL_WEB_IMAGE|PORTAL_API_IMAGE|PORTAL_WORKER_IMAGE)
      base="$(env_value "$env_file" "$variable" "")"
      tag="$(env_value "$env_file" PORTAL_IMAGE_TAG dev)"
      [[ -n "$base" ]] || fail "$variable is missing from $(basename -- "$env_file")."
      printf '%s:%s\n' "$base" "$tag"
      ;;
    *)
      base="$(env_value "$env_file" "$variable" "")"
      [[ -n "$base" ]] || fail "$variable is missing from $(basename -- "$env_file")."
      printf '%s\n' "$base"
      ;;
  esac
}

load_tracker_image() {
  local prefix="$1" variable="$2" release_env archive_ref source_ref target_ref safe_name image output image_id
  release_env="$install_tmp/tracker/config/.env.example"
  archive_ref="$(tracker_image_ref "$release_env" "$variable")"
  source_ref="${archive_ref%@*}"
  target_ref="$(tracker_image_ref "$prefix/tracker/.env" "$variable")"
  target_ref="${target_ref%@*}"
  [[ "$source_ref" == "$target_ref" ]] \
    || fail "$variable image reference changed; use a full install (reset only incompatible data)."
  safe_name="$(printf '%s' "$archive_ref" | tr '/:@' '___').tar"
  image="$install_tmp/tracker/images/$safe_name"
  [[ -f "$image" ]] || fail "patch image is missing: $safe_name"
  output="$(docker load -i "$image")"
  printf '%s\n' "$output"
  image_id="$(awk '/Loaded image ID:/ { print $4; exit }' <<<"$output")"
  [[ -n "$image_id" ]] \
    || image_id="$(docker image inspect "${source_ref%@*}" --format '{{.Id}}' 2>/dev/null || true)"
  [[ -n "$image_id" ]] || fail "could not identify loaded image: $safe_name"
  docker tag "$image_id" "$target_ref"
  [[ "$(docker image inspect "$target_ref" --format '{{.Architecture}}')" == amd64 ]] \
    || fail "loaded patch image is not linux/amd64: $target_ref"
}

patch_suite() {
  local group="" prefix="$default_prefix" services=() variable
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --group) group="${2:-}"; shift 2 ;;
      --prefix) prefix="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
  case "$group" in
    koda|gateway|portal-web|portal-api-worker|dependency-track) ;;
    postgres) fail "PostgreSQL is not patchable in place; use a full install; reset-install.sh is only for intentional data destruction." ;;
    *) fail "unknown patch group: ${group:-<empty>}" ;;
  esac
  [[ -f "$prefix/metadata.env" && -f "$prefix/tracker/.env" \
      && -x "$prefix/koda/koda-docker" ]] \
    || fail "suite is not installed at $prefix."
  exec 8>"$prefix/.koda-suite-operation.lock"
  flock -n 8 || fail "another KODA Suite operation is already running."
  prepare_payloads
  require_same_contract "$prefix"
  require_same_file "$install_tmp/tracker/compose.yaml" "$prefix/tracker/compose.yaml"
  require_same_file "$install_tmp/tracker/compose.airgap.yaml" "$prefix/tracker/compose.airgap.yaml"
  require_same_file "$script_dir/compose.integration.yaml" "$prefix/tracker/compose.integration.yaml"
  validate_preflight "$prefix/tracker/.env" 0
  [[ -f "$install_tmp/tracker/config/.env.example" ]] \
    || fail "Tracker release env example is missing."

  case "$group" in
    koda)
      "$prepared_koda_root/install.sh" --prefix "$prefix/koda"
      start_dashboard "$prefix"
      ;;
    gateway)
      load_tracker_image "$prefix" NGINX_IMAGE
      install -m 0644 "$script_dir/gateway/gateway.conf.template" \
        "$prefix/tracker/gateway/gateway.conf.template"
      services=(gateway)
      ;;
    portal-web)
      load_tracker_image "$prefix" PORTAL_WEB_IMAGE
      services=(portal-web)
      ;;
    portal-api-worker)
      for variable in PORTAL_API_IMAGE PORTAL_WORKER_IMAGE; do
        load_tracker_image "$prefix" "$variable"
      done
      services=(portal-api portal-worker)
      ;;
    dependency-track)
      for variable in DTRACK_APISERVER_IMAGE DTRACK_FRONTEND_IMAGE; do
        load_tracker_image "$prefix" "$variable"
      done
      services=(dtrack-apiserver dtrack-frontend)
      ;;
  esac
  if [[ ${#services[@]} -gt 0 ]]; then
    suite_compose "$prefix" up -d --no-build --pull never \
      --no-deps --force-recreate "${services[@]}"
  fi
  install -m 0755 "$script_dir/koda-suite" "$prefix/koda-suite"
  runtime_health "$prefix"
  printf '%s group=%s suite=%s manifest=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$group" \
    "$(metadata_value "$script_dir/metadata.env" SUITE_VERSION)" \
    "$(sha256sum "$script_dir/manifest.sha256" | awk '{print $1}')" \
    >> "$prefix/patches.log"
  echo "patched KODA Suite group: $group"
}

start_suite() {
  parse_prefix "$@"
  require_runtime
  [[ -x "$prefix/tracker/scripts/start-airgap.sh" && -x "$prefix/koda/koda-docker" ]] \
    || fail "suite is not installed at $prefix."
  "$prefix/tracker/scripts/preflight-airgap.sh" "$prefix/tracker/.env"
  start_dashboard "$prefix"
  suite_compose "$prefix" up -d --no-build --pull never
  runtime_health "$prefix"
}

status_suite() {
  parse_prefix "$@"
  require_runtime
  [[ -f "$prefix/tracker/.env" && -x "$prefix/koda/koda-docker" ]] \
    || fail "suite is not installed at $prefix."
  "$prefix/koda/koda-docker" dashboard status
  suite_compose "$prefix" ps
  runtime_health "$prefix"
}

stop_suite() {
  parse_prefix "$@"
  require_runtime
  [[ -f "$prefix/tracker/.env" && -x "$prefix/koda/koda-docker" ]] \
    || fail "suite is not installed at $prefix."
  suite_compose "$prefix" stop
  "$prefix/koda/koda-docker" dashboard stop
  echo "suite stopped; named volumes were preserved"
}

case "${1:-}" in
  verify) shift; [[ $# -eq 0 ]] || fail "verify takes no options."; verify_release ;;
  preflight) shift; preflight_suite "$@" ;;
  install) shift; install_suite "$@" ;;
  patch) shift; patch_suite "$@" ;;
  start) shift; start_suite "$@" ;;
  status) shift; status_suite "$@" ;;
  stop) shift; stop_suite "$@" ;;
  -h|--help|"") usage ;;
  *) fail "unknown command: $1" ;;
esac
