# Suite/gateway overrides only. Keep database credentials, image references,
# Compose project identity, and volume names in .env.
PUBLIC_HTTP_PORT=8088
GATEWAY_SERVER_NAME=_
TRACKER_SECURE_COOKIES=true
KODA_BASE_PATH=/koda/
KODA_DASHBOARD_BIND=127.0.0.1
KODA_PORT=8765
KODA_PUBLISH_DASHBOARD=0
KODA_DASHBOARD_NETWORK=koda-dashboard
KODA_PORTAL_UPSTREAM=koda-dashboard:8765
TRACKER_SESSION_UPSTREAM=portal-api:8000

# Production must terminate TLS before this gateway and preserve HTTPS.
# TRACKER_ENVIRONMENT=development is the only loopback/plain-HTTP exception.
TRACKER_ENVIRONMENT=production
TRACKER_PUBLIC_ORIGIN=https://koda.example.internal
GATEWAY_PUBLIC_SCHEME=https
DTRACK_API_BASE_URL=https://koda.example.internal/dependency-track
DTRACK_ADMIN_API_BASE_URL=https://koda.example.internal/dependency-track/api
APP_NETWORK_SUBNET=172.30.80.0/24
GATEWAY_APP_IP=172.30.80.10
TRACKER_TRUSTED_PROXY_CIDRS=172.30.80.10/32

KODA_SSBOM_TRACKER_URL=/
# GitLab 운영자 잠금 설정(웹에서 설정할 때는 비움). 경로는 호스트 절대경로입니다.
# 조회 토큰은 read_api, 쓰기 토큰은 api 범위이며 두 토큰은 같은 계정에서 발급합니다.
# Tracker 토큰 디렉터리와 공유 프로비저닝 토큰은 비워 두면 Suite가 안전한 기본 경로에 생성합니다.
KODA_GITLAB_URL=
KODA_GITLAB_TOKEN_FILE=
KODA_GITLAB_WRITE_TOKEN_FILE=
KODA_GITLAB_CA_FILE=
# Only koda-dashboard is attached to this egress network. Do not attach Tracker
# or Dependency-Track; restrict the network's firewall destinations to GitLab HTTPS.
KODA_GITLAB_NETWORK=
KODA_TRACKER_URL=http://koda-sbom-gateway:8080
KODA_TRACKER_TOKEN_DIR=
KODA_TRACKER_PROVISIONING_TOKEN_FILE=
KODA_TRACKER_RESULT_TIMEOUT_SECONDS=900
KODA_TRACKER_CA_FILE=
KODA_SCHEDULE_ENABLED=0
# 스케줄 점검에서 사용할 읽기 전용 SSH 키와 known_hosts가 있는 호스트 디렉터리.
# 활성화할 때만 지정하며 컨테이너에는 /run/koda/ssh로 읽기 전용 연결됩니다.
KODA_SCHEDULE_SSH_DIR=
# Docker hard ceilings. Admin settings apply within these ceilings.
KODA_SCHEDULE_STATE_DIR=
KODA_SCHEDULE_CPUS=1
KODA_SCHEDULE_MEMORY=4g
KODA_SCHEDULE_RATE_BYTES=5242880
KODA_SCHEDULE_GAP_SECONDS=30
KODA_SCHEDULE_DISK_RESERVE_BYTES=1073741824
KODA_SCHEDULE_MIN_FREE_BYTES=1073741824
KODA_CPUS=2
KODA_MEMORY=4g
KODA_PIDS_LIMIT=256
KODA_TMPFS_SIZE=512m
